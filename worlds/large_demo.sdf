<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <world name="large_demo">
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 100 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <!-- <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation> -->
      <direction>-0.5 0.1 -0.9</direction>
      <intensity>5</intensity>
    </light>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <!-- Ambient temperature for the thermal camera. Any visual without its
         own Thermal plugin (terrain, rocks, trees, water) renders at this
         temperature, adjusted by the gradient for height. 288.15 K = 15 C.
         Must stay inside the camera's min/max_temp (275-320 K). -->
    <!-- <atmosphere type="adiabatic">
      <temperature>288.15</temperature>
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere> -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>0</shadows>
      <grid>0</grid>
    </scene>
    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>
    <!-- Standing person from Fuel, defined inline, not with <include>, so the
         Thermal plugin can go on its visual. Ignition ignores the plugin at
         <include> level, and an included model's visuals can't be reached
         from here. This gives the mesh itself body heat, so nothing extra
         shows up in the RGB feed (unlike the old person1_heat box). The mesh
         still loads from the Fuel URL and uses the local cache. -->
    <model name="person1">
      <pose>-6.36 -3.07 0.08 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="bottom">
          <pose>0 -0.1 0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 0.35 0.02</size>
            </box>
          </geometry>
        </collision>
        <collision name="person">
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/standing%20person/3/files/meshes/standing.dae</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/standing%20person/3/files/meshes/standing.dae</uri>
            </mesh>
          </geometry>
          <!-- Body surface temperature: 310 K = 37 C. -->
          <plugin filename="ignition-gazebo-thermal-system" name="ignition::gazebo::systems::Thermal">
            <temperature>310.0</temperature>
          </plugin>
        </visual>
      </link>
    </model>
    <!-- Animals beside person1. Dynamic, so they settle onto the terrain and
         can be dragged with the Gazebo transform tool. -->
    <include>
      <uri>model://kangaroo</uri>
      <name>demo_animal</name>
      <pose>-5.2 -3.1 0.05 0 0 0</pose>
    </include>
    <include>
      <uri>model://wombat</uri>
      <name>wombat1</name>
      <pose>-7.5 -3.1 0.05 0 0 0</pose>
    </include>
    <!-- ANIMALS BEGIN: generated by scripts/place_animals.py -->
    <!-- Animals scattered over the scenery, each set down on the ground
         under its footprint. Dynamic, like the two above. -->
    <include>
      <uri>model://kangaroo</uri>
      <name>kangaroo_scatter_1</name>
      <pose>17.83 32.95 9.820 0.071 0.026 0.513</pose>
    </include>
    <include>
      <uri>model://kangaroo</uri>
      <name>kangaroo_scatter_2</name>
      <pose>48.16 -1.33 -0.767 0.130 0.040 -1.148</pose>
    </include>
    <include>
      <uri>model://kangaroo</uri>
      <name>kangaroo_scatter_3</name>
      <pose>-13.74 0.54 -0.542 0.100 -0.057 -1.468</pose>
    </include>
    <include>
      <uri>model://kangaroo</uri>
      <name>kangaroo_scatter_4</name>
      <pose>23.05 32.89 9.596 -0.050 -0.067 -1.163</pose>
    </include>
    <include>
      <uri>model://kangaroo</uri>
      <name>kangaroo_scatter_5</name>
      <pose>29.92 -6.38 -1.375 0.031 0.038 2.648</pose>
    </include>
    <include>
      <uri>model://kangaroo</uri>
      <name>kangaroo_scatter_6</name>
      <pose>35.75 -4.09 -1.406 0.028 0.008 0.207</pose>
    </include>
    <include>
      <uri>model://wombat</uri>
      <name>wombat_scatter_1</name>
      <pose>5.96 32.64 9.814 0.055 -0.085 -1.798</pose>
    </include>
    <include>
      <uri>model://wombat</uri>
      <name>wombat_scatter_2</name>
      <pose>47.30 4.05 -0.273 0.106 0.025 -0.282</pose>
    </include>
    <include>
      <uri>model://wombat</uri>
      <name>wombat_scatter_3</name>
      <pose>11.16 33.42 9.705 0.039 -0.040 -0.670</pose>
    </include>
    <include>
      <uri>model://wombat</uri>
      <name>wombat_scatter_4</name>
      <pose>3.69 10.30 0.225 0.128 0.026 -0.931</pose>
    </include>
    <include>
      <uri>model://wombat</uri>
      <name>wombat_scatter_5</name>
      <pose>22.87 -4.14 -1.690 0.028 0.060 2.754</pose>
    </include>
    <include>
      <uri>model://wombat</uri>
      <name>wombat_scatter_6</name>
      <pose>-15.42 7.13 -1.114 -0.055 -0.019 0.881</pose>
    </include>
    <!-- ANIMALS END -->
    <include>
      <uri>model://blue_mountains</uri>
      <name>blue_mountains</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <!-- AeroAid ute base station. The drones spawn on its pads: this pose puts
         the scout pad under parrot1's spawn (2, 0) and the courier pad under
         parrot2's (2.47, -1.10) - see 41068_ignition.launch.py. -->
    <include>
      <uri>model://aeroaid_ute</uri>
      <name>aeroaid_ute</name>
      <pose>2.47 0.87 0 0 0 1.5708</pose>
    </include>
  </world>
</sdf>